# APP_IMAGE must be your own reviewed app digest, not a mutable tag.
ARG APP_IMAGE
ARG UV_IMAGE
FROM ${UV_IMAGE} AS uv
FROM ${APP_IMAGE}
USER root
COPY --from=uv /uv /usr/local/bin/uv
COPY requirements-tracking.lock /tmp/requirements-tracking.lock
COPY tracking-wheelhouse /tmp/tracking-wheelhouse
ENV UV_OFFLINE=1 UV_PYTHON_DOWNLOADS=never PIP_NO_INDEX=1 MLFLOW_DISABLE_TELEMETRY=true
RUN --network=none uv pip install --python /opt/venv/bin/python --no-index --find-links /tmp/tracking-wheelhouse --require-hashes -r /tmp/requirements-tracking.lock \
    && rm -rf /tmp/tracking-wheelhouse /tmp/requirements-tracking.lock
# Fail the build if the worker runtime cannot import its own dependencies.
RUN --network=none /opt/venv/bin/python -c "import mlflow, mlflow.sklearn, promiseops.worker"
USER 10001:10001
ENTRYPOINT ["/opt/venv/bin/python", "-m", "promiseops.worker"]